# Pi Proxy Server — environment template.
# Copy to .env and fill in real values.

# SQLite database URL (used by Prisma).
DATABASE_URL=file:./db/custom.db

# AgentRouter API key. Obtain from https://ps.air-outer.com/console/token
# This is the upstream key the proxy forwards to AgentRouter.
PI_GATEWAY_API_KEY=

# Upstream endpoints (no trailing slash).
# OpenAI-format: base URL that already includes /v1.
PI_UPSTREAM_OPENAI=https://agentrouter.org/v1
# Anthropic-format: base URL without /v1 (the proxy appends /v1/messages).
PI_UPSTREAM_ANTHROPIC=https://agentrouter.org

# Optional: browser cookie string forwarded to the upstream on every request.
# AgentRouter sits behind an Aliyun WAF slider captcha that may challenge
# non-browser requests. Solve the captcha once in a browser, then copy the
# `acw_tc` cookie (and any session cookies) here so server-side requests pass.
PI_UPSTREAM_COOKIE=

# Optional: set to "1" to force the proxy into demo mode globally.
# In demo mode, the proxy returns well-formed simulated OpenAI/Anthropic SSE
# streams without contacting the upstream. Useful for verifying the proxy
# plumbing when the upstream is unreachable.
# Per-request override: send header `x-pi-demo: 1`.
PI_DEMO_MODE=0
