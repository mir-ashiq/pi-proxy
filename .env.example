# Pi Proxy Server — environment template.
# Copy to .env and fill in real values.

# SQLite database URL (used by Prisma, unrelated to the proxy itself).
DATABASE_URL=file:./db/custom.db

# Path to Pi's models.json config. The proxy reads providers from here.
# Default: ~/.pi/agent/models.json
# PI_CONFIG_PATH=/home/you/.pi/agent/models.json

# Set to "1" to force the proxy into demo mode globally (no upstream calls).
# Per-request override: send header `x-pi-demo: 1`.
PI_DEMO_MODE=0

# Per-provider cookie overrides (rare; mainly for WAF bypass).
# Replace <ProviderName> with the provider name from models.json
# (with non-alphanumeric chars removed).
# PI_UPSTREAM_COOKIE_AgentRouterOpenAI=acw_tc=...

# API keys for your providers go here. They are referenced from
# models.json using the $ENV_VAR syntax, e.g.:
#   "apiKey": "$OPENAI_API_KEY"
# The proxy resolves $ENV_VAR references at request time.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# PI_GATEWAY_API_KEY=sk-...
